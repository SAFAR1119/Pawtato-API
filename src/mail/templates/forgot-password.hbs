<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>Reset your Pawtato password</title>
    <style>
      @media only screen and (max-width: 600px) {
        .pawtato-container {
          width: 100% !important;
        }
        .pawtato-card {
          border-radius: 0 !important;
          padding: 28px 24px !important;
        }
      }
    </style>
  </head>
  <body
    style="margin: 0; padding: 0; background-color: #f4ede1; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;"
  >
    <table
      role="presentation"
      width="100%"
      cellpadding="0"
      cellspacing="0"
      style="background-color: #f4ede1;"
    >
      <tr>
        <td align="center" style="padding: 32px 16px;">
          <table
            role="presentation"
            class="pawtato-container"
            width="560"
            cellpadding="0"
            cellspacing="0"
            style="width: 560px; max-width: 560px;"
          >
            <tr>
              <td
                class="pawtato-card"
                style="background-color: #fbf7ef; border-radius: 20px; padding: 40px;"
              >
                <div
                  style="font-family: Georgia, 'Times New Roman', serif; font-weight: bold; font-size: 20px; color: #241f18;"
                >
                  Pawtato
                </div>

                <div
                  style="height: 1px; line-height: 1px; font-size: 1px; background-color: #7c8557; opacity: 0.55; margin: 16px 0 28px 0;"
                >
                  &nbsp;
                </div>

                <h1
                  style="margin: 0 0 16px 0; font-family: Georgia, 'Times New Roman', serif; font-weight: bold; font-size: 26px; line-height: 1.3; color: #241f18;"
                >
                  Let's get you back in
                </h1>

                <p
                  style="margin: 0 0 28px 0; font-size: 15px; line-height: 1.6; color: #4b463d;"
                >
                  Hi {{name}} — someone asked to reset the password for
                  this account. If that was you, pick a new one here.
                </p>

                <table role="presentation" cellpadding="0" cellspacing="0">
                  <tr>
                    <td
                      style="background-color: #c1683c; border-radius: 999px;"
                    >
                      <a
                        href="{{resetUrl}}"
                        style="display: inline-block; padding: 14px 28px; font-size: 15px; font-weight: bold; color: #ffffff; text-decoration: none;"
                        >Choose a new password</a
                      >
                    </td>
                  </tr>
                </table>

                <p
                  style="margin: 28px 0 0 0; font-size: 13px; line-height: 1.6; color: #9c9284;"
                >
                  This link expires in {{expiresIn}} and can be used once.
                  If the button doesn't work:<br />
                  <a href="{{resetUrl}}" style="color: #c1683c;"
                    >{{resetUrl}}</a
                  >
                </p>

                <table
                  role="presentation"
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  style="margin: 24px 0 0 0;"
                >
                  <tr>
                    <td
                      style="background-color: #fbe1d0; border-radius: 12px; padding: 16px 20px; font-size: 14px; line-height: 1.6; color: #7a3b22;"
                    >
                      Didn't ask for this? Nothing has changed yet — you
                      can safely ignore this email. Your pets' pages are
                      unaffected.
                    </td>
                  </tr>
                </table>

                <p
                  style="margin: 28px 0 0 0; font-size: 13px; line-height: 1.6; color: #9c9284;"
                >
                  Requested from {{requestContext}}<br />
                  Pawtato · Dhanmondi, Dhaka ·
                  <a href="mailto:{{supportEmail}}" style="color: #9c9284;"
                    >{{supportEmail}}</a
                  >
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
