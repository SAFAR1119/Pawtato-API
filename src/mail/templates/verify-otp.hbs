<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>Your Pawtato verification code</title>
    <style>
      @media only screen and (max-width: 600px) {
        .pawtato-container {
          width: 100% !important;
        }
        .pawtato-card {
          border-radius: 0 !important;
          padding: 28px 24px !important;
        }
      }
    </style>
  </head>
  <body
    style="margin: 0; padding: 0; background-color: #f4ede1; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;"
  >
    <table
      role="presentation"
      width="100%"
      cellpadding="0"
      cellspacing="0"
      style="background-color: #f4ede1;"
    >
      <tr>
        <td align="center" style="padding: 32px 16px;">
          <table
            role="presentation"
            class="pawtato-container"
            width="560"
            cellpadding="0"
            cellspacing="0"
            style="width: 560px; max-width: 560px;"
          >
            <tr>
              <td
                class="pawtato-card"
                style="background-color: #fbf7ef; border-radius: 20px; padding: 40px;"
              >
                <div
                  style="font-family: Georgia, 'Times New Roman', serif; font-weight: bold; font-size: 20px; color: #241f18;"
                >
                  Pawtato
                </div>

                <div
                  style="height: 1px; line-height: 1px; font-size: 1px; background-color: #7c8557; opacity: 0.55; margin: 16px 0 28px 0;"
                >
                  &nbsp;
                </div>

                <h1
                  style="margin: 0 0 16px 0; font-family: Georgia, 'Times New Roman', serif; font-weight: bold; font-size: 26px; line-height: 1.3; color: #241f18;"
                >
                  Confirm it's you
                </h1>

                <p
                  style="margin: 0 0 28px 0; font-size: 15px; line-height: 1.6; color: #4b463d;"
                >
                  Hi {{name}} — enter this code to verify your email and
                  activate your Pawtato account.
                </p>

                <table role="presentation" cellpadding="0" cellspacing="0">
                  <tr>
                    <td
                      style="background-color: #f4ede1; border-radius: 12px; padding: 18px 28px;"
                    >
                      <span
                        style="font-family: Georgia, 'Times New Roman', serif; font-weight: bold; font-size: 32px; letter-spacing: 8px; color: #241f18;"
                        >{{otp}}</span
                      >
                    </td>
                  </tr>
                </table>

                <p
                  style="margin: 28px 0 0 0; font-size: 13px; line-height: 1.6; color: #9c9284;"
                >
                  This code expires in {{expiresIn}}. Don't share it with
                  anyone — Pawtato staff will never ask for it.
                </p>

                <p
                  style="margin: 28px 0 0 0; font-size: 13px; line-height: 1.6; color: #9c9284;"
                >
                  Didn't request this? Ignore this email and nothing
                  happens.<br />
                  Pawtato · Dhanmondi, Dhaka ·
                  <a href="mailto:{{supportEmail}}" style="color: #9c9284;"
                    >{{supportEmail}}</a
                  >
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
