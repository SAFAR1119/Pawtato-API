# --- App ---
PORT=5000
NODE_ENV=development
API_PREFIX=api
# Public base URL the app is reachable at (used in generated QR codes, log messages).
APP_URL=http://localhost:5000
# The frontend app's base URL — verify-email/reset-password links point here, not at this API.
FRONTEND_URL=http://localhost:3000
# Comma-separated list of allowed CORS origins, e.g. https://app.pawtato.com,https://admin.pawtato.com
CORS_ORIGINS=

# --- Database ---
MONGO_URI=mongodb://admin:password@localhost:27017/pawtato?authSource=admin

# --- Auth ---
JWT_SECRET=
JWT_EXPIRES=1d
REFRESH_SECRET=
REFRESH_EXPIRES=7d

# --- Mail (optional; vaccination reminders and other emails are skipped/fail silently without it) ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=Pawtato <no-reply@pawtato.app>

# --- Storage ---
# local: files are written to ./uploads and served from /uploads (zero external deps, default).
# s3: files go to an S3-compatible bucket (AWS S3, DigitalOcean Spaces, Cloudflare R2, MinIO).
STORAGE_PROVIDER=local

# Required only when STORAGE_PROVIDER=s3.
S3_BUCKET=
S3_REGION=
# Set for non-AWS S3-compatible providers (DO Spaces, R2, MinIO); leave blank for AWS S3.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional: base URL used to build public file links (e.g. a CDN or custom domain).
# Defaults to the bucket's standard AWS S3 URL when unset.
S3_PUBLIC_URL=
# Set to true for providers that require path-style URLs (commonly MinIO).
S3_FORCE_PATH_STYLE=false

# --- Push/SMS (Phase 17) ---
# No real provider is wired yet — PushChannel/SmsChannel log what they would
# send instead of calling FCM/APNs/Twilio. Nothing to configure here today;
# this section is a placeholder for when a real provider is added.

# --- QR Tag Commerce / Stripe (Phase 19; optional — unset just disables ordering) ---
# Test-mode secret key from the Stripe dashboard. Leave blank in an
# environment that doesn't need tag ordering — POST /tag-orders returns a
# clear 503 instead of the app failing to boot.
STRIPE_SECRET_KEY=
# Signing secret for the /tag-orders/webhook endpoint (from `stripe listen`
# locally, or the dashboard's webhook config in production).
STRIPE_WEBHOOK_SECRET=
# No product catalog exists yet — a single flat per-tag price in cents.
TAG_UNIT_PRICE_CENTS=999
STRIPE_CURRENCY=usd

# --- Web Push (Phase 17 completion; optional — unset just disables real push delivery) ---
# Generate a pair with `npm run vapid:generate`. Leave blank in an
# environment that doesn't need push — PushChannel logs a warning and skips
# sending instead of the app failing to boot. VAPID_PUBLIC_KEY is also
# served to the frontend via GET /notifications/vapid-public-key so the
# browser's PushManager.subscribe() can use it directly.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address push services may use to reach you about this
# application's traffic (required by the Web Push protocol itself, not
# Pawtato-specific).
VAPID_SUBJECT=mailto:no-reply@pawtato.app
